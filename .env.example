# Server Configuration
SERVER_CREATE_PORT=8080
SERVER_CALLBACK_PORT=8081
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=script_monitor
DB_SSLMODE=disable
DB_MAX_CONN=10

# SSH Configuration
SSH_TIMEOUT=30s
SSH_PORT=22

# Callback Security
CALLBACK_TOKEN=your-super-secret-token-here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
